{
  "format": 1,
  "comment": "The launcher's design system. Theme.ps1 makes the window's brushes, text styles and control templates from this file only. A colour is '#RRGGBB', or { colour, opacity } for a translucent one.",
  "colour": {
    "night": "#120824",
    "night2": "#1B0B3A",
    "violet": "#3A1368",
    "magenta": "#8E1F86",
    "rose": "#E0356F",
    "coral": "#FF7A45",
    "gold": "#FFC24A",
    "sunTop": "#FFE08A",
    "sunMid": "#FFB04A",
    "sunLow": "#FF6A5A",
    "accent": "#FF3D8B",
    "onAccent": "#1B0A24",
    "text": "#FFFFFF",
    "textSoft": "#E6D8F0",
    "textMuted": "#C9B8DA",
    "field": "#24123F",
    "switchOff": "#3A2A52",
    "switchKnobOff": "#C9B8DA",
    "stepWaiting": "#6B5A85",
    "reflection": "#FF9E5E",
    "focus": "#FFC24A",
    "panel": { "colour": "#120824", "opacity": 0.86 },
    "panelStrong": { "colour": "#120824", "opacity": 0.9 },
    "stroke": { "colour": "#FFFFFF", "opacity": 0.14 },
    "strokeStrong": { "colour": "#FFFFFF", "opacity": 0.28 },
    "rowLine": { "colour": "#FFFFFF", "opacity": 0.1 }
  },
  "gradient": {
    "sky": {
      "direction": "vertical",
      "stops": [
        { "colour": "#170A33", "offset": 0 },
        { "colour": "#3A1368", "offset": 0.3 },
        { "colour": "#8E1F86", "offset": 0.52 },
        { "colour": "#E0356F", "offset": 0.68 },
        { "colour": "#FF7A45", "offset": 0.8 },
        { "colour": "#FFC24A", "offset": 0.88 }
      ]
    },
    "sea": {
      "direction": "vertical",
      "height": 150,
      "stops": [
        { "colour": "#3A1368", "offset": 0 },
        { "colour": "#1B0B3A", "offset": 0.45 },
        { "colour": "#120824", "offset": 1 }
      ]
    },
    "sun": {
      "direction": "vertical",
      "stops": [
        { "colour": "#FFE08A", "offset": 0 },
        { "colour": "#FFB04A", "offset": 0.55 },
        { "colour": "#FF6A5A", "offset": 1 }
      ]
    },
    "play": {
      "direction": "horizontal",
      "stops": [
        { "colour": "#FFC24A", "offset": 0 },
        { "colour": "#FF8A3D", "offset": 0.45 },
        { "colour": "#FF3D8B", "offset": 1 }
      ]
    },
    "fadeTop": {
      "comment": "Dark fade over the sky toward the top, so text reads well.",
      "direction": "vertical",
      "stops": [
        { "colour": { "colour": "#120824", "opacity": 0.6 }, "offset": 0 },
        { "colour": { "colour": "#120824", "opacity": 0 }, "offset": 0.45 }
      ]
    },
    "fadeSide": {
      "comment": "Dark fade toward the options panel on the right.",
      "direction": "horizontal",
      "stops": [
        { "colour": { "colour": "#120824", "opacity": 0 }, "offset": 0.45 },
        { "colour": { "colour": "#120824", "opacity": 0.55 }, "offset": 1 }
      ]
    }
  },
  "scene": {
    "sun": { "left": 150, "bottom": 96, "size": 240 },
    "reflections": [
      { "left": 170, "bottom": 132, "width": 200, "height": 4, "opacity": 0.6 },
      { "left": 200, "bottom": 120, "width": 140, "height": 3, "opacity": 0.4 }
    ]
  },
  "glow": {
    "play": { "colour": "#FF3D8B", "opacity": 0.45, "blur": 40, "offsetY": 10 }
  },
  "type": {
    "display": {
      "family": "Bahnschrift Condensed, Impact, Segoe UI",
      "weight": "Bold",
      "upper": true,
      "letterSpacingEm": 0.04,
      "comment": "Stands in for the design's Anton; no font is added to the repository."
    },
    "body": { "family": "Segoe UI Variable Text, Segoe UI", "weight": "Normal" },
    "caption": { "weight": "SemiBold", "upper": true, "letterSpacingEm": 0.08 },
    "size": {
      "play": 40,
      "titleLarge": 34,
      "title": 28,
      "titleSmall": 24,
      "body": 14,
      "small": 13,
      "caption": 12
    }
  },
  "size": {
    "windowWidth": 960,
    "windowHeight": 640,
    "panelWidth": 330,
    "playWidth": 320,
    "playHeight": 84,
    "controlHeight": 44,
    "switchWidth": 46,
    "switchHeight": 26,
    "knob": 20,
    "focusThickness": 2,
    "focusOffset": 2
  },
  "layout": {
    "comment": "The window's layout, from the design files: margins and paddings of the views, rows and icons.",
    "viewPadding": 32,
    "panelPadding": 22,
    "cardPadding": 28,
    "cardWidth": 560,
    "moreMargin": 24,
    "morePaddingX": 28,
    "morePaddingY": 24,
    "columnGap": 40,
    "sectionGap": 22,
    "rowHeight": 52,
    "switchRowHeight": 48,
    "stepRowHeight": 40,
    "selectWidth": 180,
    "selectHeight": 40,
    "progressHeight": 10,
    "statusDot": 8,
    "statusWidth": 420,
    "linkRowHeight": 28,
    "iconPlay": 28,
    "iconChevron": 16,
    "iconLink": 14,
    "iconStep": 18,
    "sunGlowScale": 1.8,
    "sunGlowOpacity": 0.55,
    "disabledOpacity": 0.45
  },
  "radius": {
    "control": 10,
    "play": 14,
    "panel": 16,
    "card": 18
  },
  "space": [4, 8, 12, 14, 18, 20, 22, 32],
  "motion": {
    "backgroundFadeMs": 900,
    "viewFadeMs": 200,
    "glowBreathMs": 8000,
    "glowMin": 0.85,
    "glowMax": 1.0
  }
}
